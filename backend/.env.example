PORT=5000
NODE_ENV=development

# Database configuration
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_NAME=HelpFlow
DB_HOST=127.0.0.1
DB_PORT=5432

# JWT Secrets (Generate secure random strings in production)
ACCESS_TOKEN_SECRET=your_access_token_secret_value_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_value_here

# Token Durations (15 minutes access, 7 days refresh)
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS Configuration
CLIENT_URL=http://localhost:3000
